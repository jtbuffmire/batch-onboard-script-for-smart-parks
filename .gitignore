# Local credentials -- never commit
.env
.env.local
.env.*.local

# Local Python venv (created by batch-onboard.sh)
.venv/

# Local state -- per-deployment, not shared
onboarded.json
onboarded.json.tmp
.last-batch.json

# Generated device reports (per-deployment audit artifacts)
reports/

# Caches
__pycache__/
*.pyc
*.pyo

# Vendor delivery sheets carry LoRaWAN app keys -- never commit
*.xlsx

# Settings schemas copied from configure.buoy.fish for --report decoding
settings_v*.json
settings-v*.json
settings-meta.json
